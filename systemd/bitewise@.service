[Unit]
Description=bitewise meal tracker (%i)
After=network-online.target

[Service]
# Repo paths below are placeholders, rendered by systemd/install.sh
WorkingDirectory=@BITEWISE_HOME@
# One instance per user: data lives in data/<instance>, port comes from the env file
Environment=BITEWISE_DATA=@BITEWISE_HOME@/data/%i
EnvironmentFile=%h/.config/bitewise/%i.env
ExecStart=@BITEWISE_HOME@/.venv/bin/python -m bitewise --host 0.0.0.0 --port ${BITEWISE_PORT}
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
