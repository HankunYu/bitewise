# Model provider for all users: anthropic (default) | openai | google
#BITEWISE_PROVIDER=anthropic

# API key of the chosen provider.
ANTHROPIC_API_KEY=
#OPENAI_API_KEY=
#GEMINI_API_KEY=

# Listen address. Keep 127.0.0.1 behind a reverse proxy; use 0.0.0.0 only on a trusted LAN.
#BITEWISE_HOST=127.0.0.1
#BITEWISE_PORT=8600
